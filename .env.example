# Server
SERVER_PORT=8040
SERVER_HOST=0.0.0.0
READ_TIMEOUT=600
WRITE_TIMEOUT=600
EXTERNAL_URL=http://localhost:9053

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=dialect_corpus
DB_SSLMODE=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dialect-corpus
MINIO_USE_SSL=false
MINIO_LOCATION=cn-south-1

# Asynq
ASYNQ_CONCURRENCY=2

# Upload
MAX_UPLOAD_SIZE=524288000
